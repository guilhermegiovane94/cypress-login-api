{
  "name": "cypress-login-api",
  "version": "1.0.0",
  "description": "Projeto Cypress de validação de login somente no backend (API) com Page Object e dados via JSON",
  "scripts": {
    "cy:open": "cypress open --e2e --env ENVIRONMENT=staging --browser chrome",
    "cy:run": "cypress run --e2e --env ENVIRONMENT=staging --browser chrome",
    "cy:open:staging": "cypress open --e2e --env ENVIRONMENT=staging --browser chrome",
    "cy:run:staging": "cypress run --e2e --env ENVIRONMENT=staging --browser chrome",
    "cy:open:production": "cypress open --e2e --env ENVIRONMENT=production --browser chrome",
    "cy:run:production": "cypress run --e2e --env ENVIRONMENT=production --browser chrome",
    "cy:open:e2e": "cypress open --e2e --env ENVIRONMENT=staging --browser chrome",
    "cy:open:e2e:staging": "cypress open --e2e --env ENVIRONMENT=staging --browser chrome",
    "cy:open:e2e:production": "cypress open --e2e --env ENVIRONMENT=production --browser chrome",
    "cy:run:e2e": "cypress run --e2e --env ENVIRONMENT=staging --browser chrome",
    "cy:run:e2e:staging": "cypress run --e2e --env ENVIRONMENT=staging --browser chrome",
    "cy:run:e2e:production": "cypress run --e2e --env ENVIRONMENT=production --browser chrome",
    "test:e2e:staging": "cypress run --e2e --env envName=staging --browser chrome && node scripts/generate-report.js staging",
    "test:e2e:prod": "cypress run --e2e --env envName=production --browser chrome && node scripts/generate-report.js production",
    "test": "cypress run --e2e --env ENVIRONMENT=staging --browser chrome"
  },
  "devDependencies": {
    "cypress": "^13.15.0",
    "mochawesome": "^7.1.3",
    "mochawesome-merge": "^4.3.0",
    "mochawesome-report-generator": "^5.2.0"
  }
}
